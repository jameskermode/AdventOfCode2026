cabal-version:      3.0
name:               AdventOfCode2026
version:            0.1.0.0
synopsis:           Advent of Code 2026 solutions in Haskell
license:            MIT
license-file:       LICENSE
author:             James Kermode
maintainer:         james.kermode@gmail.com
category:           Development
build-type:         Simple
extra-doc-files:    CHANGELOG.md, README.md

common shared
    ghc-options:      -Wall
    default-language: GHC2021
    build-depends:
        base ^>=4.20.2.0,
        bytestring,
        containers,
        megaparsec,
        split,
        text,
        vector

library
    import:           shared
    hs-source-dirs:   src

    -- Add each new DayNN module here, and to the table in src/Days.hs.
    exposed-modules:
        AoC
        Days
        Day01

executable AdventOfCode2026
    import:           shared
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    AdventOfCode2026, directory
    ghc-options:      -O2 -threaded -rtsopts

test-suite AdventOfCode2026-test
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        AdventOfCode2026,
        tasty,
        tasty-hunit
